# When BOOTSTRAP=true tells the bench-dev container to run the
# setup scripts when it starts. They create the Frappe bench if
# needed, switch Frappe to the configured version, fetch/install
# the configured apps, build assets, then create or update the
# support site.
BOOTSTRAP=true
# When RESET_SITE=true. When bootstrapping, that makes the
# site script drop the existing support site’s database and files
# before recreating it—so existing site data can be lost
RESET_SITE=false
FRAPPE_VERSION=version-15
# The value after # is the app branch
FRAPPE_APPS=telephony,helpdesk#main-hotfix
SITE_NAME=support
ADMIN_PASSWORD=admin
PYTHON_BIN=python3.12
